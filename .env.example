# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Optional Live Payment Gateway Keys (set in server runtime environment, never commit secrets)
# When configured, GCash, Maya, and Credit/Debit Card (Visa/Mastercard) use live checkout sessions.
PAYMONGO_SECRET_KEY=""
STRIPE_SECRET_KEY=""
PAYMENT_SESSION_SECRET=""

# Optional Merchant Settlement Details (displayed for QR / Bank Transfer instructions)
MERCHANT_GCASH_NUMBER=""
MERCHANT_MAYA_NUMBER=""
MERCHANT_BANK_ACCOUNT=""

