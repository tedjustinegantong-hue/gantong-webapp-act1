{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Filipino artisan streetwear product in the Habing Kalye catalog.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "name": { "type": "string", "minLength": 2, "maxLength": 140 },
        "slug": { "type": "string", "minLength": 2, "maxLength": 160 },
        "category": { "type": "string", "enum": ["T-Shirts", "Hoodies", "Shoes", "Bags", "Caps", "Pants & Gear"] },
        "subCategory": { "type": "string", "minLength": 2, "maxLength": 80 },
        "artisanMaterial": { "type": "string", "minLength": 2, "maxLength": 120 },
        "price": { "type": "number" },
        "description": { "type": "string", "minLength": 4, "maxLength": 1000 },
        "sizes": { "type": "array" },
        "variants": { "type": "array" },
        "defaultImage": { "type": "string", "minLength": 1, "maxLength": 500 },
        "featured": { "type": "boolean" },
        "badge": { "type": "string", "maxLength": 40 },
        "totalStock": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "name", "slug", "category", "subCategory", "artisanMaterial", "price", "description", "sizes", "variants", "defaultImage", "featured", "badge", "totalStock", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "Authenticated shopper or administrator profile.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "displayName": { "type": "string", "minLength": 1, "maxLength": 100 },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "photoURL": { "type": "string", "maxLength": 500 },
        "role": { "type": "string", "enum": ["customer", "admin"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "displayName", "email", "role", "createdAt", "updatedAt"]
    },
    "CartItem": {
      "title": "CartItem",
      "description": "Persistent shopping bag line item scoped to an authenticated user.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "productName": { "type": "string", "minLength": 1, "maxLength": 140 },
        "category": { "type": "string", "minLength": 1, "maxLength": 60 },
        "colorName": { "type": "string", "minLength": 1, "maxLength": 60 },
        "colorHex": { "type": "string", "minLength": 4, "maxLength": 20 },
        "imageUrl": { "type": "string", "minLength": 1, "maxLength": 500 },
        "recolorHex": { "type": "string", "maxLength": 20 },
        "recolorMode": { "type": "string", "enum": ["dark-to-color", "light-to-color", "chroma-to-color"] },
        "size": { "type": "string", "minLength": 1, "maxLength": 30 },
        "price": { "type": "number" },
        "quantity": { "type": "number" },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "userId", "productId", "productName", "category", "colorName", "colorHex", "imageUrl", "size", "price", "quantity", "createdAt", "updatedAt"]
    },
    "Order": {
      "title": "Order",
      "description": "Completed customer order persisted for Order History and Admin fulfillment.",
      "type": "object",
      "properties": {
        "id": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "orderNumber": { "type": "string", "minLength": 4, "maxLength": 40 },
        "userId": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "customerName": { "type": "string", "minLength": 2, "maxLength": 100 },
        "customerEmail": { "type": "string", "minLength": 3, "maxLength": 160 },
        "customerPhone": { "type": "string", "minLength": 6, "maxLength": 40 },
        "shippingAddress": { "type": "string", "minLength": 5, "maxLength": 300 },
        "city": { "type": "string", "minLength": 2, "maxLength": 80 },
        "paymentMethod": { "type": "string", "enum": ["COD", "GCash", "Maya", "Card", "Bank Transfer"] },
        "paymentStatus": { "type": "string", "enum": ["Pay on Delivery", "Awaiting Payment", "Pending Verification", "Paid"] },
        "paymentChannel": { "type": "string", "maxLength": 80 },
        "paymentReference": { "type": "string", "maxLength": 120 },
        "gatewaySessionId": { "type": "string", "maxLength": 120 },
        "items": { "type": "array" },
        "subtotal": { "type": "number" },
        "shippingFee": { "type": "number" },
        "total": { "type": "number" },
        "status": { "type": "string", "enum": ["Pending", "Confirmed", "Preparing", "Shipped", "Delivered", "Cancelled"] },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "orderNumber", "userId", "customerName", "customerEmail", "customerPhone", "shippingAddress", "city", "paymentMethod", "paymentStatus", "items", "subtotal", "shippingFee", "total", "status", "createdAt", "updatedAt"]
    },
    "AdminRecord": {
      "title": "AdminRecord",
      "description": "Explicit administrator privilege grant document.",
      "type": "object",
      "properties": {
        "uid": { "type": "string", "minLength": 1, "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "email": { "type": "string", "minLength": 3, "maxLength": 160 },
        "grantedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "grantedAt"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Public storefront product catalog; admin-only writes."
    },
    "/users/{userId}": {
      "schema": { "$ref": "#/entities/UserProfile" },
      "description": "User profile containing PII; strictly restricted to owner or admin."
    },
    "/users/{userId}/cart/{cartItemId}": {
      "schema": { "$ref": "#/entities/CartItem" },
      "description": "User shopping bag line items; strictly restricted to owner."
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders; readable by owner or admin, writable by owner on create and admin on status fulfillment."
    },
    "/admins/{adminId}": {
      "schema": { "$ref": "#/entities/AdminRecord" },
      "description": "Explicit admin grants; readable and writable only by admins."
    }
  }
}
